  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv2_mc_two_supplies
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv2_mc_two_supplies
  Type: 4
  Complexity: 1
  Prompt: Which pair of arterial systems supplies the brain?
  TargetStructureId: 
  LabelText: 
  Options:
  - Internal carotid and vertebral arteries
  - Pulmonary and bronchial arteries
  - Renal and splenic arteries
  - Femoral and iliac arteries
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The internal carotid arteries supply the front of the brain and the
    vertebral arteries the back. They meet at the Circle of Willis.
  Hint: One pair runs up the neck at the front, the other through the vertebrae.
