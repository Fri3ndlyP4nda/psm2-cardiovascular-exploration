  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv2_flow_vertebral
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv2_flow_vertebral
  Type: 2
  Complexity: 3
  Prompt: Order the vertebral route to the back of the brain.
  TargetStructureId: 
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps:
  - Subclavian Artery
  - Vertebral Artery
  - Basilar Artery
  - Posterior Cerebral Artery
  Explanation: The vertebral arteries branch from the subclavian arteries, run up
    through the vertebrae, and merge to form the basilar artery, which supplies the
    posterior brain.
  Hint: The two vertebral arteries join before they branch again.
--- !u!114 &7444445566406092392
MonoBehaviour:
  m_ObjectHideFlags: 0
