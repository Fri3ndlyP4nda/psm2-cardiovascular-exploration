  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv2_mc_blood_brain_barrier
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv2_mc_blood_brain_barrier
  Type: 4
  Complexity: 2
  Prompt: What does the blood-brain barrier do?
  TargetStructureId: 
  LabelText: 
  Options:
  - Restricts which substances can pass from blood into brain tissue
  - Pumps blood upwards against gravity
  - Stores oxygen for the brain
  - Filters blood the way the kidney does
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: It is formed by tight junctions between capillary endothelial cells,
    letting oxygen and glucose through while blocking many toxins, pathogens and
    drugs.
  Hint: The clue is in the word 'barrier'.
--- !u!114 &-3399488739369269423
MonoBehaviour:
