  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv2_mc_oxygen_share
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv2_mc_oxygen_share
  Type: 4
  Complexity: 3
  Prompt: Roughly what proportion of the body's oxygen does the resting brain consume?
  TargetStructureId: 
  LabelText: 
  Options:
  - About 20%
  - About 2%
  - About 50%
  - About 75%
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: About 20%, despite the brain being only around 2% of body weight.
    That mismatch is why even a brief interruption of cerebral blood flow causes
    symptoms so quickly.
  Hint: It is far out of proportion to the brain's share of body weight.
--- !u!114 &-5373025001896584338
MonoBehaviour:
  m_ObjectHideFlags: 0
