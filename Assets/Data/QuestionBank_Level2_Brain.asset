  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv2_flow_venous_return
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv2_flow_venous_return
  Type: 2
  Complexity: 2
  Prompt: Order the route deoxygenated blood takes leaving the brain.
  TargetStructureId: 
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps:
  - Cerebral Veins
  - Dural Venous Sinuses
  - Internal Jugular Vein
  - Superior Vena Cava
  - Right Atrium
  Explanation: Cerebral veins drain into venous sinuses within the dura, which empty
    into the internal jugular veins and return to the right atrium via the superior
    vena cava.
  Hint: Finish at the chamber that receives all deoxygenated blood from the upper
    body.
