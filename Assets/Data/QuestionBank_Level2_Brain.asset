  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv2_mc_basilar
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv2_mc_basilar
  Type: 4
  Complexity: 2
  Prompt: The two vertebral arteries merge to form which vessel?
  TargetStructureId: 
  LabelText: 
  Options:
  - Basilar artery
  - Aorta
  - Superior vena cava
  - Carotid sinus
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The basilar artery. It runs along the front of the brainstem and supplies
    the cerebellum and posterior cerebrum.
  Hint: It sits at the base of the brain, which is where its name comes from.
