  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv2_mc_venous_drainage
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv2_mc_venous_drainage
  Type: 4
  Complexity: 2
  Prompt: Which vessels return most deoxygenated blood from the brain to the heart?
  TargetStructureId: 
  LabelText: 
  Options:
  - Internal jugular veins
  - Pulmonary veins
  - Hepatic veins
  - Renal veins
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The internal jugular veins. They collect from the dural venous sinuses
    and drain into the brachiocephalic veins and then the superior vena cava.
  Hint: They run down the neck alongside the carotid arteries.
