  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_drag_left_ventricle
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_drag_left_ventricle
  Type: 1
  Complexity: 1
  Prompt: Drag the label onto the chamber it names.
  TargetStructureId: left_ventricle
  LabelText: Left Ventricle
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: Correct. The left ventricle is the systemic pump - the chamber that
    supplies the whole body except the lungs.
  Hint: Drop it on the chamber floor around you.
--- !u!114 &-6075247342398464273
MonoBehaviour:
