  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_id_left_ventricle
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_id_left_ventricle
  Type: 0
  Complexity: 1
  Prompt: Click the chamber that pumps oxygenated blood into the aorta.
  TargetStructureId: left_ventricle
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The left ventricle has the thickest myocardium of the four chambers,
    because it must generate enough pressure to drive blood through the entire systemic
    circulation.
  Hint: It is the large chamber you are standing in.
--- !u!114 &6169531306729533709
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
