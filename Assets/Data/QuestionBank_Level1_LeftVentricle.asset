  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_mc_chordae
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_mc_chordae
  Type: 4
  Complexity: 3
  Prompt: What connects the papillary muscles to the cusps of the mitral valve?
  TargetStructureId: 
  LabelText: 
  Options:
  - Chordae tendineae
  - Coronary arteries
  - Purkinje fibres
  - The interventricular septum
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: Chordae tendineae - fine tendinous cords, sometimes called heart strings.
    They stop the valve cusps from being pushed inside out by ventricular pressure.
  Hint: The name translates roughly as 'tendinous cords'.
--- !u!114 &7065506965693700409
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_id_papillary
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_id_papillary
  Type: 0
  Complexity: 2
  Prompt: Click the muscular pillars that anchor the mitral valve.
  TargetStructureId: papillary_muscle
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: Papillary muscles contract along with the ventricle and pull on the
    chordae tendineae. That tension holds the mitral cusps shut so they cannot invert
    back into the atrium.
  Hint: Two thick columns rising from the chamber floor.
