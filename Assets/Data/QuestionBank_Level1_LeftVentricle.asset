  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_id_septum
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_id_septum
  Type: 0
  Complexity: 2
  Prompt: Click the wall separating this chamber from the right ventricle.
  TargetStructureId: interventricular_septum
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The interventricular septum is a thick muscular wall. A hole in it
    is called a ventricular septal defect, which allows oxygenated and deoxygenated
    blood to mix.
  Hint: It is the flat, darker wall along one side of the chamber.
