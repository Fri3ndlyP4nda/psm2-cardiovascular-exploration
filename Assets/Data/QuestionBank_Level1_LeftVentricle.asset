  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_mc_blood_type
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_mc_blood_type
  Type: 4
  Complexity: 1
  Prompt: What kind of blood does the left ventricle pump?
  TargetStructureId: 
  LabelText: 
  Options:
  - Oxygenated blood
  - Deoxygenated blood
  - An even mixture of both
  - Lymph
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: Oxygenated. Blood arrives from the lungs via the pulmonary veins into
    the left atrium, then passes to the left ventricle and out to the body.
  Hint: Consider where the blood arriving in the left atrium has just come from.
--- !u!114 &-4872095559907088765
MonoBehaviour:
  m_ObjectHideFlags: 0
