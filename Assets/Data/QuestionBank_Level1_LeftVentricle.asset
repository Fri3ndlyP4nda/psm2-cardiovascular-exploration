  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_flow_left_heart
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_flow_left_heart
  Type: 2
  Complexity: 2
  Prompt: Put the path of oxygenated blood through the left heart into the correct
    order.
  TargetStructureId: 
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps:
  - Left Atrium
  - Mitral Valve
  - Left Ventricle
  - Aortic Valve
  - Aorta
  Explanation: Blood returning from the lungs enters the left atrium, passes the
    mitral valve into the left ventricle, and is forced through the aortic valve
    into the aorta.
  Hint: Start in the chamber that receives blood from the pulmonary veins.
--- !u!114 &-3103892144029156500
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_id_mitral_valve
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_id_mitral_valve
  Type: 0
  Complexity: 1
  Prompt: Click the valve blood passes through when it enters this chamber from the
    left atrium.
  TargetStructureId: mitral_valve
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The mitral valve (also called bicuspid, because it has two cusps)
    sits between the left atrium and the left ventricle. It closes during contraction
    so blood cannot flow back into the atrium.
  Hint: Look back towards the inflow end of the chamber.
--- !u!114 &-1634732784905158946
