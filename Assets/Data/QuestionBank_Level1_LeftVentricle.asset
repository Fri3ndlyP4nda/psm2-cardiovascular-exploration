  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_valve_semilunar
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_valve_semilunar
  Type: 3
  Complexity: 3
  Prompt: Click the semilunar valve of the left heart - the one with three half-moon
    cusps.
  TargetStructureId: aortic_valve
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The aortic valve. 'Semilunar' describes the half-moon shape of each
    of its three cusps. The pulmonary valve on the right side is the other semilunar
    valve.
  Hint: Semilunar valves sit at the exit from a ventricle, not the entrance.
--- !u!114 &3827327490442087385
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
