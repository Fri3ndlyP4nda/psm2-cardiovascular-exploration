  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_valve_backflow
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_valve_backflow
  Type: 3
  Complexity: 2
  Prompt: Click the valve that prevents blood flowing back into the left atrium while
    the ventricle contracts.
  TargetStructureId: mitral_valve
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The mitral valve. During systole the rising ventricular pressure forces
    its two cusps together, sealing the atrium off.
  Hint: Backflow into the atrium is stopped at the inflow end.
--- !u!114 &-7848167371467590957
