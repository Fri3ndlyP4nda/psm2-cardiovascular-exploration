  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv1_mc_thickest_wall
  m_EditorClassIdentifier: Cardio.Runtime::Cardio.Data.PuzzleData
  PuzzleId: lv1_mc_thickest_wall
  Type: 4
  Complexity: 1
  Prompt: Which heart chamber has the thickest muscular wall?
  TargetStructureId: 
  LabelText: 
  Options:
  - Left ventricle
  - Right ventricle
  - Left atrium
  - Right atrium
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The left ventricle. It pumps against the high resistance of the whole
    systemic circulation, so it needs far more muscle than the other chambers.
  Hint: Think about which chamber has to push blood the furthest.
--- !u!114 &2867097901323812842
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
