  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_mc_gas_exchange
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_mc_gas_exchange
  Type: 4
  Complexity: 3
  Prompt: Where in the pulmonary circuit does gas exchange actually take place?
  TargetStructureId: 
  LabelText: 
  Options:
  - In the capillaries surrounding the alveoli
  - Inside the right ventricle
  - In the wall of the aorta
  - In the superior vena cava
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: In the dense capillary network wrapping each alveolus. The barrier
    there is thin enough for oxygen and carbon dioxide to diffuse across in a fraction
    of a second.
  Hint: It happens where the blood vessels are thinnest and closest to air.
--- !u!114 &1494327056815122512
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
