  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_flow_right_heart
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_flow_right_heart
  Type: 2
  Complexity: 2
  Prompt: Order the path of deoxygenated blood through the right heart.
  TargetStructureId: 
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps:
  - Superior Vena Cava
  - Right Atrium
  - Tricuspid Valve
  - Right Ventricle
  - Pulmonary Valve
  - Pulmonary Artery
  Explanation: Deoxygenated blood returns via the vena cavae to the right atrium,
    passes the tricuspid valve into the right ventricle, and is pumped through the
    pulmonary valve into the pulmonary artery.
  Hint: Start with the vessel bringing blood down from the head and arms.
