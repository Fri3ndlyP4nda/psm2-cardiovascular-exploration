  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_mc_wall_thickness
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_mc_wall_thickness
  Type: 4
  Complexity: 2
  Prompt: Why is the right ventricle wall thinner than the left ventricle wall?
  TargetStructureId: 
  LabelText: 
  Options:
  - It pumps against the much lower resistance of the lungs
  - It holds far less blood
  - It beats only half as often
  - It contains no cardiac muscle
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: Both ventricles eject a similar volume per beat, but pulmonary circulation
    is a low-pressure circuit, so the right ventricle needs far less muscle to do
    its job.
  Hint: Think about pressure rather than volume.
--- !u!114 &4826855053187592213
MonoBehaviour:
  m_ObjectHideFlags: 0
