  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_mc_pressure
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_mc_pressure
  Type: 4
  Complexity: 3
  Prompt: 'Compared with the systemic circulation, the pulmonary circulation is:'
  TargetStructureId: 
  LabelText: 
  Options:
  - A lower-pressure circuit
  - A higher-pressure circuit
  - At identical pressure
  - Not a closed circuit at all
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: Much lower pressure. Pulmonary arterial pressure is roughly a fifth
    of systemic arterial pressure, which protects the delicate alveolar capillaries
    from damage.
  Hint: Delicate lung tissue could not survive systemic pressures.
