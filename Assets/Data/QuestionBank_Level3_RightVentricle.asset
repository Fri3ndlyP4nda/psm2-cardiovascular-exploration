  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_mc_vena_cava
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_mc_vena_cava
  Type: 4
  Complexity: 1
  Prompt: Which vessels return deoxygenated blood to the right atrium?
  TargetStructureId: 
  LabelText: 
  Options:
  - Superior and inferior vena cava
  - The pulmonary veins
  - The aorta and carotids
  - The hepatic arteries
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The superior vena cava drains the head, neck and arms; the inferior
    vena cava drains everything below the diaphragm. Both empty into the right atrium.
  Hint: One drains the upper body, the other the lower.
