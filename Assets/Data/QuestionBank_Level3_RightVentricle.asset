  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_flow_pulmonary_circuit
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_flow_pulmonary_circuit
  Type: 2
  Complexity: 3
  Prompt: Order the pulmonary circuit, from leaving the right ventricle to arriving
    in the left heart.
  TargetStructureId: 
  LabelText: 
  Options: []
  CorrectOptionIndex: 0
  SequenceSteps:
  - Pulmonary Artery
  - Lungs
  - Pulmonary Veins
  - Left Atrium
  Explanation: 'This is the pulmonary circulation: blood is sent to the lungs to
    be oxygenated and returns to the left atrium, ready to be pumped around the body.'
  Hint: Gas exchange happens in the middle of this sequence.
--- !u!114 &5895432590858741150
MonoBehaviour:
  m_ObjectHideFlags: 0
