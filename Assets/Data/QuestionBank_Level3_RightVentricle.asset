  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_mc_circuit_definition
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_mc_circuit_definition
  Type: 4
  Complexity: 3
  Prompt: 'Pulmonary circulation is best described as the circuit that carries blood:'
  TargetStructureId: 
  LabelText: 
  Options:
  - From the right heart to the lungs and back to the left heart
  - From the left heart to the body and back
  - From the heart to the liver and back
  - Between the two atria directly
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: 'That is the definition. Systemic circulation is the other loop: left
    heart, out to the body, back to the right heart. The two run in series.'
  Hint: It is the loop that involves the lungs.
--- !u!114 &2078944284543198917
