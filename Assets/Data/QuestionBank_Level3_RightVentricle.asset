  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_mc_pulmonary_valve
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_mc_pulmonary_valve
  Type: 4
  Complexity: 2
  Prompt: Which valve stops blood falling back from the pulmonary artery into the
    right ventricle?
  TargetStructureId: 
  LabelText: 
  Options:
  - Pulmonary valve
  - Tricuspid valve
  - Mitral valve
  - Aortic valve
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The pulmonary valve. Like the aortic valve it is semilunar, with three
    cusps, and closes as the ventricle relaxes.
  Hint: It is named after the vessel it guards.
