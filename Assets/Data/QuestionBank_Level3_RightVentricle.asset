  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_mc_rv_blood
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_mc_rv_blood
  Type: 4
  Complexity: 1
  Prompt: What kind of blood does the right ventricle pump?
  TargetStructureId: 
  LabelText: 
  Options:
  - Deoxygenated blood
  - Oxygenated blood
  - An even mixture of both
  - Plasma only
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: Deoxygenated. The right heart receives blood returning from the body
    and sends it to the lungs to pick up oxygen.
  Hint: Consider where the right ventricle sends blood next.
--- !u!114 &7924394505421260761
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
