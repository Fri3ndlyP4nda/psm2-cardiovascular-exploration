  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_mc_pulmonary_artery
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_mc_pulmonary_artery
  Type: 4
  Complexity: 2
  Prompt: 'The pulmonary artery is unusual among arteries because:'
  TargetStructureId: 
  LabelText: 
  Options:
  - It carries deoxygenated blood away from the heart
  - It carries oxygenated blood towards the heart
  - It has no muscular wall
  - It contains no valves anywhere in the circuit
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: Arteries are defined by carrying blood away from the heart, not by
    oxygen content. The pulmonary artery is the main exception to the usual 'arteries
    carry oxygenated blood' shorthand.
  Hint: The definition of an artery is about direction, not oxygen.
