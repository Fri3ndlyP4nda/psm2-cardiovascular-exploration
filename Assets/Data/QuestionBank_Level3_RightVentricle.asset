  m_Script: {fileID: 11500000, guid: 5774bd79aa42c7f42b20b5b97d4c619d, type: 3}
  m_Name: lv3_mc_tricuspid
  m_EditorClassIdentifier: Assembly-CSharp::Cardio.Data.PuzzleData
  PuzzleId: lv3_mc_tricuspid
  Type: 4
  Complexity: 1
  Prompt: Which valve sits between the right atrium and the right ventricle?
  TargetStructureId: 
  LabelText: 
  Options:
  - Tricuspid valve
  - Mitral valve
  - Aortic valve
  - Pulmonary valve
  CorrectOptionIndex: 0
  SequenceSteps: []
  Explanation: The tricuspid valve. It is the right-side counterpart of the mitral
    valve, but has three cusps rather than two.
  Hint: Its name tells you how many cusps it has.
--- !u!114 &3537712595650189921
